{
  "compilerOptions": {
    "strict": true,
    "strictPropertyInitialization": true,
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "moduleResolution": "bundler",
    "target": "ES2018",
    "lib": ["ES2018"],
    "module": "esnext",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"]
}
